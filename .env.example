# MoeSync Environment Variables Template
# Copy this file to .env and fill in your developer credentials:
#   cp .env.example .env
#
# Compile / run the app with:
#   flutter run --dart-define-from-file=.env
# Or build for Android:
#   flutter build apk --dart-define-from-file=.env

# MyAnimeList (https://myanimelist.net/apiconfig)
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# AniList (https://anilist.co/settings/developer)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Shikimori (https://shikimori.one/oauth/applications)
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=

# Simkl (https://simkl.com/settings/developer/new/)
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# MangaBaka (https://mangabaka.org/account/developer)
MANGABAKA_CLIENT_ID=
